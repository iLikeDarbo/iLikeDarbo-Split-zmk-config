// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>  //see https://zmk.dev/docs/keymaps/behaviors/bluetooth
#include <dt-bindings/zmk/outputs.h>  //see https://zmk.dev/docs/keymaps/behaviors/outputs

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    // https://zmk.dev/docs/keymaps

    // LC(C) = LEFT_CONTROL + C
    //see https://zmk.dev/docs/keymaps/modifiers#modifier-functions

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";  //layer 0
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T                   &kp Y &kp U &kp I &kp O &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G                   &kp H &kp J &kp K &kp L &kp RET
                &mt LC(Z) Z  &mt LC(X) X  &mt LC(C) C  &mt LC(V) V  &kp B    &kp N &kp M &kp COMMA &kp DOT &kp FSLH
                        &kp LSHFT &mo 1 &kp LCTRL           &kp RALT &lt 2 BSPC &kp SPACE
            >;
        };
        number_layer {
            display-name = "Number Layer";  //layer 1
            bindings = <
                &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY  &kp KP_SUBTRACT       &kp KP_EQUAL &kp LBKT &kp RBKT &kp F9 &kp F10
                &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_SLASH  &kp KP_PLUS              &kp TAB &kp F1 &kp F3 &kp F4 &kp RET
                &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N0  &kp KP_DOT                  &kp F5 &kp F6 &kp F11 &kp DOT &kp FSLH
                        &kp LSHFT &none &kp LCTRL                                       &kp RALT &kp BSPC &kp SPACE
            >;
        };
        function_layer {
            display-name = "Function Layer";  //layer 2
            bindings = <
                &kp ESC  &kp F2  &kp LPAR  &kp STAR  &kp MINUS          &kp EQUAL &kp F7 &kp F8 &kp F9 &bt BT_SEL 0
                &kp TAB  &kp APOS  &kp RPAR  &kp DQT  &kp PLUS          &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PSCRN
                &kp GUI  &kp NUHS  &kp LALT  &kp LG(L)  &kp NUBS        &kp SEMI &kp EXCL &kp DLLR &kp PG_UP &kp PG_DN
                        &kp LSHFT &mo 1 &kp LCTRL                       &kp RALT &kp BSPC &kp SPACE
            >;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_BT_CLR {
            timeout-ms = <50>;
            key-positions = <0 2>;  //Q - E
            bindings = <&bt BT_CLR>;
        };
        combo_BT_SEL_0 {
            timeout-ms = <50>;
            key-positions = <10 12>;  //A - D
            bindings = <&bt BT_SEL 0>;
        };
        combo_BT_DISC_0 {
            timeout-ms = <50>;
            key-positions = <20 22>;  //Z - C
            bindings = <&bt BT_DISC 0>;
        };
        combo_BLE_OUT {
            timeout-ms = <50>;      //O - P
            key-positions = <8 9>;    //see https://zmk.dev/docs/keymaps/behaviors/outputs
            bindings = <&out OUT_BLE>;  //allow usage while charging power bank
        };
    };
};

